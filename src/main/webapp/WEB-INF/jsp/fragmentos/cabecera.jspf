<%-- Cabecera común. La página que la incluye debe declarar las etiquetas c y fmt
     y definir la variable "titulo" con c:set antes de incluir este fragmento. --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<fmt:setLocale value="es_ES"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> · Empresa</title>
    <link rel="stylesheet" href="${ctx}/css/estilos.css">
</head>
<body>
    <header class="cabecera">
        <a class="marca" href="${ctx}/">Empresa · Gestión de empleados</a>
    </header>

    <main class="contenedor">
        <h1><c:out value="${titulo}"/></h1>
